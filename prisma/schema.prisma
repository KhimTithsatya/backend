generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  OTHER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  profileImage String? @db.LongText
  role      Role     @default(USER)
  authProviders String @default("credentials")
  sessionVersion Int @default(1)
  heightCm Float?
  weightKg Float?
  age Int?
  sex String?
  activityLevel String?
  goalType String?
  dailyCalorieTarget Int?
  proteinGoal Int?
  carbsGoal Int?
  fatGoal Int?
  timezone String @default("UTC")
  dateFormat String @default("YYYY-MM-DD")
  language String @default("en")
  notifyMealReminders Boolean @default(false)
  notifyWeeklySummary Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //  opposite relation for Meal.user
  meals Meal[]
  passwordResetTokens PasswordResetToken[]
  sessions UserSession[]
}

model Food {
  id        Int      @id @default(autoincrement())
  name      String
  calories  Int
  image     String?  @db.LongText
  protein   Float? // optional
  carbs     Float? // optional
  fat       Float? // optional
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // foods can be used in many meal items
  items MealItem[]
}

model Meal {
  id        Int      @id @default(autoincrement())
  name      String
  description String? @db.Text
  userId    Int
  plannedFor DateTime?
  mealType  MealType @default(OTHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //  relation to User
  user User @relation(fields: [userId], references: [id])

  // a meal has many items (foods + quantity)
  items MealItem[]
}

model MealItem {
  id        Int      @id @default(autoincrement())
  mealId    Int
  foodId    Int
  quantity  Int      @default(1) // 1 serving by default
  createdAt DateTime @default(now())

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([mealId, foodId]) // same food appears once per meal (quantity handles count)
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id          Int       @id @default(autoincrement())
  userId      Int
  sid         String    @unique
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  lastActiveAt DateTime?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
